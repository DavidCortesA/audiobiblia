# Dirección pública del sitio (sin / al final)
NEXT_PUBLIC_SITE_URL=https://audio-biblia.vercel.app
# Correo de contacto que se muestra en el pie y en Privacidad
NEXT_PUBLIC_CONTACT_EMAIL=
# Página de Facebook cuyos videos se usan como alternativa (Montaña De Dios)
NEXT_PUBLIC_FACEBOOK_PAGE_ID=590229140997160

# Notificaciones push: genera las llaves con  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Token que usa la Mac para enviar el calendario (credenciales/web_token.txt)
SYNC_TOKEN=
# Lo pone Vercel para proteger el cron de avisos (cualquier texto largo y aleatorio)
CRON_SECRET=

# Upstash Redis (Vercel → Storage → Upstash for Redis las crea solas)
KV_REST_API_URL=
KV_REST_API_TOKEN=
